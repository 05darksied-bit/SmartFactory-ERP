# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# JWT Authentication (replace with 64+ random hex chars in production)
JWT_SECRET=replace_with_a_long_random_secret

# MySQL Connection (use DB_HOST=localhost locally, DB_HOST=db inside Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartfactory_erp
DB_USER=root
DB_PASSWORD=your_mysql_password

# Docker MySQL Root Password (used only by MySQL container in Docker Compose)
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# Factory GST / Invoice Identity
FACTORY_NAME=SmartFactory Foods
FACTORY_GSTIN=33AAAAA0000A1Z5
FACTORY_STATE_CODE=33
FACTORY_ADDRESS=Tamil Nadu, India
