{
  "name": "smartfactory-erp",
  "version": "1.2.0",
  "description": "Order-to-Audit ERP prototype for a small food manufacturer",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "start:prod": "node backend/scripts/migrate.js && node backend/scripts/seed.js --if-empty && node backend/app.js",
    "dev": "nodemon backend/app.js",
    "test": "jest --runInBand",
    "test:unit": "node --test tests/*.node.test.js",
    "migrate": "node backend/scripts/migrate.js",
    "seed": "node backend/scripts/seed.js",
    "seed:safe": "node backend/scripts/seed.js --if-empty",
    "reset-seed": "node backend/scripts/seed.js",
    "benchmark": "node backend/scripts/run-benchmark.js",
    "verify": "npm run test:unit && node scripts/verify-static.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "pdfkit": "^0.15.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/*.test.js",
      "!**/tests/*.node.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
