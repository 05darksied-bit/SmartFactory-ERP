# Production Environment Template for Docker Cloud VPS
# Copy to .env on your VPS and replace ALL placeholder secrets before starting!
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-domain.com

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_HEX_SECRET

# Docker internal MySQL networking (service name: db)
DB_HOST=db
DB_PORT=3306
DB_NAME=smartfactory_erp
# Least-privilege application account (NOT root)
DB_USER=smartfactory_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_APP_PASSWORD

# MySQL root password (used only by the db container)
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_ROOT_PASSWORD

# Factory GST / Invoice Identity
FACTORY_NAME=SmartFactory Foods
FACTORY_GSTIN=33AAAAA0000A1Z5
FACTORY_STATE_CODE=33
FACTORY_ADDRESS=Tamil Nadu, India
